def handle_request(request):
    identity = policyshield.validate(request)
    meta = guardrails_input(request.prompt, request.document)
    memory = load_memory(request.session_id)

    route_type = route(request.prompt, request.document, meta.category)

    if route_type == "RAG_LOCAL":
        plan = ["INDEX", "SEARCH", "CALL_LLM"]
        workflow_engine.start(request.trace_id, plan)

        ctx = search_context(request.prompt)
        answer = rag_flow(request.prompt, ctx)

        guardrails_output(answer)
        persist_memory(request.session_id, "RAG_OK")

        return answer
