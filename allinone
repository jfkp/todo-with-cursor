from genkit import flow, step

@flow(name="rag_answer_flow")
def rag_answer_flow(question: str, context: str) -> str:
    """
    Workflow applicatif Genkit.
    Aucune logique de sécurité ici.
    """

    enriched_prompt = build_prompt(question, context)
    answer = call_llm(enriched_prompt)

    return answer
4️⃣ Définition des étapes (steps)
Étape 1 — Construction du prompt
@step
def build_prompt(question: str, context: str) -> str:
    return f"""
    Tu es un assistant fiable.
    Réponds uniquement à partir du contexte ci-dessous.

    CONTEXTE:
    {context}

    QUESTION:
    {question}
    """
Étape 2 — Appel LLM
@step
def call_llm(prompt: str) -> str:
    response = genkit.generate(
        model="gpt-4o-mini",
        prompt=prompt,
        temperature=0.2
    )
    return response.text
