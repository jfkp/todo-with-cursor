@app.post("/auth/validate")
def validate(request: Request):
    token = request.headers.get("Authorization")
    identity = casdoor.validate_token(token)
    allowed = casbin.enforce(identity.user, "assistant", "invoke")

    log_access(identity, allowed)

    if not allowed:
        raise HTTPException(403, "Access denied")

    return {"status": "ALLOW", "identity": identity.dict()}
